  "lessons": [
    {
      "id": "a1-personal-pronouns",
      "sourceLevel": "A1",
      "skill": "grammar",
      "title": "Personal pronouns",
      "explanation": "German personal pronouns change form depending on who is speaking or being spoken about. The subject pronouns are: ich (I), du (you, informal singular), er/sie/es (he/she/it), wir (we), ihr (you, informal plural), sie (they), Sie (you, formal). Unlike English, German pronoun choice for \"you\" depends on formality and number.",
      "examples": [
        "Ich heiße Anna.",
        "Du bist mein Freund.",
        "Er wohnt in Berlin.",
        "Wir lernen Deutsch."
      ]
    },
    {
      "id": "a1-greetings-farewells",
      "sourceLevel": "A1",
      "skill": "vocabulary",
      "title": "Greetings and farewells",
      "explanation": "Common German greetings vary by time of day and formality. \"Hallo\" and \"Guten Tag\" are general greetings; \"Guten Morgen\" is for mornings, \"Guten Abend\" for evenings. \"Tschüss\" is informal for goodbye, \"Auf Wiedersehen\" is formal.",
      "examples": [
        "Guten Morgen!",
        "Hallo, wie geht's?",
        "Auf Wiedersehen!",
        "Tschüss, bis bald!"
      ]
    },
    {
      "id": "a1-speaking-self-introduction",
      "sourceLevel": "A1",
      "skill": "speaking",
      "title": "Introducing yourself",
      "explanation": "Introducing yourself in German typically includes your name, where you're from, and maybe your age, using simple present-tense sentences: 'Ich heiße...', 'Ich komme aus...', 'Ich bin ... Jahre alt.'",
      "examples": [
        "Ich heiße Lisa.",
        "Ich komme aus Spanien.",
        "Ich bin 25 Jahre alt.",
        "Ich wohne in München."
      ]
    },
    {
      "id": "a1-present-tense-regular",
      "sourceLevel": "A1",
      "skill": "grammar",
      "title": "Present tense of regular verbs",
      "explanation": "Regular German verbs in the present tense add endings to the verb stem based on the subject: -e (ich), -st (du), -t (er/sie/es), -en (wir), -t (ihr), -en (sie/Sie). E.g., lernen → ich lerne, du lernst, er lernt.",
      "examples": [
        "Ich lerne Deutsch.",
        "Du lernst schnell.",
        "Wir lernen zusammen.",
        "Sie lernen Englisch."
      ]
    },
    {
      "id": "a1-sein-haben",
      "sourceLevel": "A1",
      "skill": "grammar",
      "title": "The verbs \"sein\" and \"haben\"",
      "explanation": "sein (to be) and haben (to have) are essential irregular verbs. sein: ich bin, du bist, er ist, wir sind, ihr seid, sie sind. haben: ich habe, du hast, er hat, wir haben, ihr habt, sie haben.",
      "examples": [
        "Ich bin müde.",
        "Du hast einen Hund.",
        "Wir sind Freunde.",
        "Sie haben Zeit."
      ]
    },
    {
      "id": "telc-a1-sprachbausteine-format",
      "sourceLevel": "A1",
      "skill": "writing",
      "title": "TELC Sprachbausteine format",
      "explanation": "TELC's \"Sprachbausteine\" (language building blocks) section tests grammar and vocabulary through short gap-fill texts, where candidates choose the correct word from three options to complete a coherent short text — testing contextual grammar recognition rather than free production.",
      "examples": [
        "Ich ___ (a: bin / b: bist / c: ist) Student.",
        "Complete: 'Er wohnt ___ (a: in / b: an / c: auf) Berlin.'"
      ]
    },
    {
      "id": "a1-numbers-1-100",
      "sourceLevel": "A1",
      "skill": "vocabulary",
      "title": "Numbers 1-100",
      "explanation": "German numbers 1-12 have unique names; 13-19 add \"-zehn\"; tens end in \"-zig\" (except 30: dreißig); numbers 21-99 combine units and tens in reverse order with \"und\" (e.g., 21 = einundzwanzig).",
      "examples": [
        "eins, zwei, drei",
        "zehn, zwanzig, dreißig",
        "einundzwanzig (21)",
        "hundert (100)"
      ]
    },
    {
      "id": "a1-family-members",
      "sourceLevel": "A1",
      "skill": "vocabulary",
      "title": "Family members",
      "explanation": "Basic family vocabulary: die Mutter (mother), der Vater (father), die Schwester (sister), der Bruder (brother), die Eltern (parents), die Großmutter/der Großvater (grandmother/grandfather).",
      "examples": [
        "Meine Mutter heißt Julia.",
        "Mein Bruder ist 10 Jahre alt.",
        "Das sind meine Eltern.",
        "Meine Großmutter kocht gern."
      ]
    },
    {
      "id": "a1-definite-articles",
      "sourceLevel": "A1",
      "skill": "grammar",
      "title": "Definite articles (der, die, das)",
      "explanation": "German nouns have three genders, each with its own definite article: der (masculine), die (feminine), das (neuter). The plural article is always \"die\". Learning the gender with each noun is essential.",
      "examples": [
        "der Mann",
        "die Frau",
        "das Kind",
        "die Kinder"
      ]
    },
    {
      "id": "a1-listening-numbers-times",
      "sourceLevel": "A1",
      "skill": "listening",
      "title": "Understanding numbers and times spoken aloud",
      "explanation": "A1 listeners should recognize spoken numbers and times, e.g., distinguishing \"um drei Uhr\" (at three) from \"um dreizehn Uhr\" (13:00), and understanding simple spoken phone numbers or prices.",
      "examples": [
        "Es ist zehn Uhr.",
        "Der Zug fährt um 8:30 Uhr.",
        "Das kostet fünf Euro.",
        "Meine Nummer ist null-eins-zwei-drei."
      ]
    },
    {
      "id": "a1-reading-simple-signs",
      "sourceLevel": "A1",
      "skill": "reading",
      "title": "Understanding simple signs",
      "explanation": "Understanding common public signs is a key A1 reading skill: e.g., \"Eingang\" (entrance), \"Ausgang\" (exit), \"Geöffnet\" (open), \"Geschlossen\" (closed), \"Kein Zutritt\" (no entry).",
      "examples": [
        "Eingang →",
        "Geöffnet: 9-18 Uhr",
        "Kein Rauchen",
        "Ausgang links"
      ]
    },
    {
      "id": "a1-listening-simple-instructions",
      "sourceLevel": "A1",
      "skill": "listening",
      "title": "Following simple spoken instructions",
      "explanation": "A1 listeners should follow short spoken instructions such as directions or classroom commands, e.g., \"Öffnen Sie das Buch\", \"Gehen Sie geradeaus\", \"Warten Sie bitte.\"",
      "examples": [
        "Öffnen Sie das Buch auf Seite 5.",
        "Gehen Sie geradeaus und dann links.",
        "Warten Sie bitte einen Moment.",
        "Setzen Sie sich, bitte."
      ]
    },
    {
      "id": "a1-reading-short-messages",
      "sourceLevel": "A1",
      "skill": "reading",
      "title": "Reading short personal messages",
      "explanation": "A1 readers should understand short personal messages and notes, recognizing key words like time, place, and names in simple written texts.",
      "examples": [
        "Treffen wir uns um 18 Uhr?",
        "Ich bin im Büro.",
        "Bis später!",
        "Kannst du Brot kaufen?"
      ]
    },
    {
      "id": "a1-writing-simple-forms",
      "sourceLevel": "A1",
      "skill": "writing",
      "title": "Filling in simple forms",
      "explanation": "A1 writers should be able to fill in simple forms with personal information: Name, Adresse, Geburtsdatum (date of birth), Telefonnummer, Nationalität.",
      "examples": [
        "Name: Maria Schmidt",
        "Adresse: Hauptstraße 12",
        "Geburtsdatum: 03.05.1998",
        "Nationalität: deutsch"
      ]
    },
    {
      "id": "a1-writing-short-postcard",
      "sourceLevel": "A1",
      "skill": "writing",
      "title": "Writing a short postcard",
      "explanation": "A1 writers should write a short, simple postcard or note describing where they are and how they feel, using simple present-tense sentences and basic connectors like \"und\" and \"aber\".",
      "examples": [
        "Liebe Anna, ich bin in Berlin. Die Stadt ist schön. Bis bald, Tom.",
        "Hallo Mama, mir geht es gut. Das Wetter ist sonnig."
      ]
    },
    {
      "id": "a1-speaking-asking-directions",
      "sourceLevel": "A1",
      "skill": "speaking",
      "title": "Asking for and giving simple directions",
      "explanation": "A1 speakers should ask for and understand simple directions using phrases like \"Wo ist...?\", \"Wie komme ich zu...?\", and basic direction words: links (left), rechts (right), geradeaus (straight ahead).",
      "examples": [
        "Wo ist der Bahnhof?",
        "Wie komme ich zum Supermarkt?",
        "Gehen Sie geradeaus und dann rechts.",
        "Es ist links von der Kirche."
      ]
    }
  ],
  "overrides": [
    {
      "lessonId": "a1-present-tense-regular",
      "track": "telc",
      "explanation": "For TELC's Sprachbausteine format, present tense verb endings are tested through multiple-choice gap-fill exercises rather than free production — focus on quickly recognizing the correct ending among similar-looking options (e.g., distinguishing -t from -en).",
      "examples": [
        "Er ___ (spielt/spielen) Fußball. → spielt",
        "Wir ___ (lernt/lernen) Deutsch. → lernen"
      ]
    }
  ],
